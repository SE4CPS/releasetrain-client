{
  "name": "releasetrain-client",
  "version": "3.24.0",
  "description": "Static browser client for Releasetrain",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "http-server src -c-1 --log-ip",
    "build": "node scripts/build.js",
    "start": "http-server dist -c-1 --log-ip",
    "prod": "npm run build && npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SE4CPS/releasetrain-client.git"
  },
  "bugs": {
    "url": "https://github.com/SE4CPS/releasetrain-client/issues"
  },
  "keywords": [
    "release",
    "versioning",
    "tracking",
    "client"
  ],
  "author": "berhes",
  "license": "ISC",
  "dependencies": {
    "http-server": "^14.1.1"
  }
}
